{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "dependencyDashboard": true,
  "minimumReleaseAge": "3 days",
  "enabledManagers": ["github-actions", "custom.regex", "pip_requirements"],
  "pip_requirements": {
    "managerFilePatterns": ["/^requirements\\.lock$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Aerodrome release pinned in the Dockerfile",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["ARG AERODROME_REF=(?<currentValue>\\S+)\\nARG AERODROME_COMMIT=(?<currentDigest>[0-9a-f]{40})"],
      "autoReplaceStringTemplate": "ARG AERODROME_REF={{{newValue}}}\nARG AERODROME_COMMIT={{{newDigest}}}",
      "depNameTemplate": "preston-peterson/aerodrome",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Renovate version used to validate this config in CI",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["renovate@(?<currentValue>\\S+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "pip-tools version used by scripts/update-lock.sh",
      "managerFilePatterns": ["/^scripts/update-lock\\.sh$/"],
      "matchStrings": ["pip_tools_version=(?<currentValue>\\S+)"],
      "depNameTemplate": "pip-tools",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "Python dependencies"
    },
    {
      "matchDepNames": ["preston-peterson/aerodrome"],
      "commitMessageTopic": "Aerodrome",
      "semanticCommitType": "chore",
      "semanticCommitScope": null,
      "prBodyNotes": ["Merging rebuilds the image from the new upstream release. CI builds, scans, and runs the integration test, including a check that the running app reports this version."]
    }
  ]
}
